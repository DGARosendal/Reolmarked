<!-- SRP: This view is responsible only for the layout of the Book reol screen.
     All logic and state live in RentalViewModel. -->

<UserControl x:Class="Reolmarked.UI.Views.RentalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Reolmarked.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="ShelfButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,2"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Black"/>
            <Setter Property="VerticalGridLinesBrush" Value="Black"/>
        </Style>
    </UserControl.Resources>

    <!-- Outer frame. This Border has exactly ONE child: the Grid below. -->
    <Border BorderBrush="Black" BorderThickness="4" Background="White" Margin="10">
        <!-- This Grid contains BOTH the main content AND the popup overlay. -->
        <Grid>
            <!-- Main content (two-column layout). -->
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: search, create renter, date, Book button. -->
                <!-- Wrapped in a ScrollViewer so the Book button stays reachable
                     even on small windows. -->
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" Padding="15" Background="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Søg efter reollejer" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Telefonnummer" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding SearchPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <DataGrid ItemsSource="{Binding SearchResults}"
                                      SelectedItem="{Binding SelectedRenter}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      Height="120"
                                      Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding RenterId}" Width="30"/>
                                    <DataGridTextColumn Header="Fornavn" Binding="{Binding FirstName}" Width="*"/>
                                    <DataGridTextColumn Header="Efternavn" Binding="{Binding LastName}" Width="*"/>
                                    <DataGridTextColumn Header="Tlf." Binding="{Binding PhoneNumber}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Separator Margin="0,10,0,15"/>

                            <TextBlock Text="Eller: Opret reollejer" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Fornavn" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding NewFirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="Efternavn" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding NewLastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="Telefonnummer" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding NewPhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <Button Content="Opret reollejer"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding CreateRenterCommand}"
                                    Margin="0,0,0,10"/>

                            <Separator Margin="0,10,0,15"/>

                            <TextBlock Text="Startdato for leje:" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,15"/>

                            <Button Content="Lej"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding BookCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right column: grid of all shelves. -->
                <Grid Grid.Column="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Shelves}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Width="360" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ShelfNumber}"
                                            Style="{StaticResource ShelfButtonStyle}"
                                            Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                            Command="{Binding DataContext.SelectShelfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Popup overlay. Sits on top of the main content. -->
            <Border Background="#80000000"
                    Visibility="{Binding IsConfirmationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Width="380"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Bekræft leje" FontSize="20" FontWeight="Bold"/>
                            <Button Content="✕"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Width="28" Height="28"
                                    Command="{Binding CancelBookingCommand}"/>
                        </Grid>

                        <TextBlock Text="Reol:" FontWeight="Bold" Margin="0,15,0,0"/>
                        <TextBlock Text="{Binding SelectedShelf.ShelfNumber}" FontSize="18"/>

                        <TextBlock Text="Startdato:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding StartDate, StringFormat=dd-MM-yyyy}" FontSize="18"/>

                        <TextBlock Text="Reollejer:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding SelectedRenter.FirstName}" FontSize="18"/>
                        <TextBlock Text="{Binding SelectedRenter.LastName}" FontSize="18"/>
                        <TextBlock Text="{Binding SelectedRenter.PhoneNumber}" FontSize="18"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="Annuller"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding CancelBookingCommand}"
                                    Width="110" Margin="5,0"/>
                            <Button Content="Bekræft"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ConfirmBookingCommand}"
                                    Width="110" Margin="5,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>