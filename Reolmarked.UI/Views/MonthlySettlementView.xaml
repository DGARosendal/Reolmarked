<UserControl x:Class="Reolmarked.UI.Views.MonthlySettlementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reolmarked.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Tekstfelt-stil der matcher wireframe med sorte kanter -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- Knap-stil der matcher ShelfView -->
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="5,0" />
        </Style>

        <!-- DataGrid-stil der matcher wireframe-udtrykket -->
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Black"/>
            <Setter Property="VerticalGridLinesBrush" Value="Black"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="Black" BorderThickness="4" Background="White" Margin="10" Padding="20,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="135"/>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            
            <!-- FIRST COLUMN - HEADER-->
            <TextBlock 
                Grid.Row="0" Grid.Column="0"
                Text="Månedsberegning" 
                FontFamily="Arial Black"
                VerticalAlignment="Center"
                FontSize="16"/>
            
            <!-- THIRD COLUMN - CHECKBOX-->
            <StackPanel 
                 Grid.Row="0"
                 Grid.Column="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center">
                <Label Content="Udbetalt/Betalt"/>
                <CheckBox VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Reollejer" />
                        <TextBox />

                        <Label Content="Start Dato" />
                        <TextBox />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Label Content="Måned" />
                        <TextBox />

                        <Label Content="Slut Dato" />
                        <TextBox />
                    </StackPanel>
                </Grid>
                <TextBlock 
                      Text="Månedsleje - Reoler" 
                      FontFamily="Arial Black"
                      FontSize="14"
                      Margin="5"/>
            </StackPanel>
            
            <Grid Grid.Row="2">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <Label Content="Antal"/>
                            <TextBox />
                        </StackPanel>
                        <StackPanel>
                            <Label Content="Reolpris"/>
                            <TextBox />
                        </StackPanel>
                        <StackPanel>
                            <Label Content="Ekstra Rabat"/>
                            <TextBox />
                        </StackPanel>
                    </StackPanel>
                     <TextBlock 
                         Text="Salg" 
                         FontFamily="Arial Black"
                         FontSize="14"
                         Margin="5"/>
                </StackPanel>

              
            </Grid>

            
            <!-- -->
            <StackPanel 
                 Grid.Row="2"
                 Grid.Column="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top">
                <StackPanel>
                    <Label Content="Samlet Reolleje"/>
                    <TextBox />
                </StackPanel>
            </StackPanel>

            <!-- -->
            <StackPanel 
                 Grid.Row="3"
                 Grid.Column="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top">
                 <StackPanel>
                    <Label Content="Samlet Salg"/>
                    <TextBox />
                 </StackPanel>
            </StackPanel>

            <!-- -->
            <StackPanel 
                 Grid.Row="4"
                 Grid.Column="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top">
                <StackPanel>
                    <Label Content="Slut Beløb*"/>
                    <TextBox />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="5"
                Text="* Fratrukket komission, samlet reolleje."
                VerticalAlignment="Bottom"
                FontFamily="Arial Black"
                FontSize="10"
                Margin="5"/>
        </Grid>
    </Border>
</UserControl>
