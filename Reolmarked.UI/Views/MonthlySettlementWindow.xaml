<Window x:Class="Reolmarked.UI.Views.MonthlySettlementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Reolmarked.UI.ViewModels"
        xmlns:local="clr-namespace:Reolmarked.UI.Views"
        mc:Ignorable="d"
        Title="MonthlySettlementWindow" Height="550" Width="800">

    <Window.DataContext>
        <viewmodels:MonthlySettlementViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Tekstfelt-stil der matcher wireframe med sorte kanter -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- Knap-stil der matcher ShelfView -->
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="5,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <!-- Page content -->

        <Border BorderBrush="Black" BorderThickness="4" Background="White" Margin="10" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="135"/>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- FIRST COLUMN - HEADER-->
                <TextBlock 
                Grid.Row="0" Grid.Column="0"
                Text="Månedsberegning" 
                FontFamily="Arial Black"
                VerticalAlignment="Center"
                FontSize="16"/>

                <!-- THIRD COLUMN - CHECKBOX-->
                <StackPanel 
                 Grid.Row="0"
                 Grid.Column="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center">
                    <Label Content="Udbetalt/Betalt"/>
                    <CheckBox VerticalAlignment="Center" 
                              IsChecked="{Binding IsProcessed}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="Reollejer" />
                            <TextBox IsReadOnly="True" Background="LightGray" Text="{Binding RenterName}"/>

                            <Label Content="Start Dato" />
                            <TextBox IsReadOnly="True" Background="LightGray" Text="{Binding StartDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Label Content="Måned" />
                            <TextBox  IsReadOnly="True" Background="LightGray" Text="{Binding Month, Mode=OneWay}"/>

                            <Label Content="Slut Dato" />
                            <TextBox IsReadOnly="True" Background="LightGray" Text="{Binding EndDate}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock 
                      Text="Månedsleje - Reoler" 
                      FontFamily="Arial Black"
                      FontSize="14"
                      Margin="5"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <Label Content="Antal"/>
                                <TextBox IsReadOnly="True" Background="LightGray" Text="{Binding ShelfCount,  Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel>
                                <Label Content="Reolpris"/>
                                <TextBox IsReadOnly="True" Background="LightGray" Text="{Binding PricePerShelf,  Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel>
                                <Label Content="Ekstra Rabat"/>
                                <TextBox IsReadOnly="True" Background="LightGray" Text="{Binding ExtraDiscount, Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock 
                         Text="Salg" 
                         FontFamily="Arial Black"
                         FontSize="14"
                         Margin="5"/>
                    </StackPanel>
                </Grid>

                <!-- -->
                <StackPanel 
                 Grid.Row="2"
                 Grid.Column="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top">
                    <StackPanel>
                        <Label Content="Samlet Reolleje"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Text="{Binding TotalShelfRent}"/>
                    </StackPanel>
                </StackPanel>

                <!-- -->
                <StackPanel 
                 Grid.Row="3"
                 Grid.Column="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top">
                    <StackPanel>
                        <Label Content="Samlet Salg"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Text="{Binding TotalSales}" />
                    </StackPanel>
                </StackPanel>

                <!-- -->
                <StackPanel 
                 Grid.Row="4"
                 Grid.Column="2"
                 Orientation="Horizontal"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top">
                    <TextBlock
                        Text="{Binding CalculationsString}"
                        VerticalAlignment="Bottom" 
                        FontFamily="Arial Black"
                        FontSize="10"
                        Margin="5"/>    
                    <StackPanel>
                        <Label Content="Slut Beløb*"/>
                        <TextBox IsReadOnly="True" Background="LightGray" Text="{Binding FinalAmount}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="5"
                Text="* Fratrukket komission, samlet reolleje."
                VerticalAlignment="Bottom" 
                FontFamily="Arial Black"
                FontSize="10"
                Margin="5"/>
            </Grid>
        </Border>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    HorizontalAlignment="Right">
            <Button Content="Tilbage" 
                    Style="{StaticResource ActionButtonStyle}" 
                    Command="{Binding CancelProcessing}"/>
            <Button Content="Godkend" 
                    Style="{StaticResource ActionButtonStyle}" 
                    Command="{Binding ConfirmProcessing}"/>
        </StackPanel>

    </Grid>
</Window>