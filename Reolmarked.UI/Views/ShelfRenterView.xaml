<UserControl x:Class="Reolmarked.UI.Views.ShelfRenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:Reolmarked.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <viewmodels:ShelfRenterViewModel />
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left side: Form for ShelfRenter -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="15" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Shelf Renter Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" />

                <TextBlock Text="First Name:" Margin="0,5,0,2" />
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="25" VerticalContentAlignment="Center" />

                <TextBlock Text="Last Name:" Margin="0,5,0,2" />
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="25" VerticalContentAlignment="Center" />

                <TextBlock Text="Phone Number:" Margin="0,5,0,2" />
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Right side: DataGrid and Action Buttons -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Renters}"
                      SelectedItem="{Binding SelectedRenter}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding RenterId}" Width="50" />
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*" />
                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*" />
                    <DataGridTextColumn Header="Phone Number" Binding="{Binding PhoneNumber}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Buttons placed directly below the list -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="Add" Command="{Binding AddCommand}" Width="80" Height="30" Margin="5,0" />
                <Button Content="Update" Command="{Binding UpdateCommand}" Width="80" Height="30" Margin="5,0" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Width="80" Height="30" Margin="5,0" />
                <Button Content="Clear Selection" Command="{Binding ClearSelectionCommand}" Width="100" Height="30" Margin="5,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>